<?xml version="1.0" encoding="UTF-8"?>
<!-- Imports a schema that starts with a DOCTYPE, like W3C's xmldsig/xenc schemas used by WS-Security. -->
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  targetNamespace="urn:root">
  <wsdl:types>
    <xs:schema targetNamespace="urn:root">
      <xs:import namespace="urn:dtd" schemaLocation="withdtd.xsd"/>
    </xs:schema>
  </wsdl:types>
</wsdl:definitions>
